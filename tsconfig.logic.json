{
  "compilerOptions": {
    "target": "ES2017", "module": "ES2015", "moduleResolution": "node",
    "strict": false, "skipLibCheck": true, "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true, "esModuleInterop": true,
    "resolveJsonModule": true, "noEmit": true, "baseUrl": ".",
    "paths": { "cc": ["types/cc-stub.d.ts"] }
  },
  "include": ["assets/scripts/**/*.ts", "types/**/*.d.ts"],
  "exclude": ["node_modules", "docs", "build", "temp", "library", "extensions"]
}
